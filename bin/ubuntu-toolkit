#!/usr/bin/env bash

# ============================================================
# Ubuntu Toolkit
# Version: 0.1.0
#
# Main CLI / Menu
#
# Ubuntu 24.04 LTS
#
# Filosofía:
#   - Safe by default
#   - No ejecutar operaciones destructivas automáticamente
#   - Delegar las tareas a scripts especializados
#   - Mantener una interfaz centralizada
# ============================================================

set -Eeuo pipefail


# Configuración


SCRIPT_NAME="$(basename "$0")"
SCRIPT_VERSION="0.1.0"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

SYSTEM_DIR="$PROJECT_ROOT/scripts/system"
DOCKER_DIR="$PROJECT_ROOT/scripts/docker"
NETWORK_DIR="$PROJECT_ROOT/scripts/network"
BACKUP_DIR="$PROJECT_ROOT/scripts/backup"
DEVELOPMENT_DIR="$PROJECT_ROOT/scripts/development"
GIT_DIR="$PROJECT_ROOT/scripts/git"
UTILITIES_DIR="$PROJECT_ROOT/scripts/utilities"


# Colores


if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    MAGENTA='\033[0;35m'
    WHITE='\033[1;37m'
    RESET='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    CYAN=''
    MAGENTA=''
    WHITE=''
    RESET=''
fi


# Funciones


separator() {
    echo
    echo "============================================================"
}

pause() {
    echo
    read -rp "Presiona ENTER para continuar..."
}

info() {
    echo -e "${CYAN}[INFO]${RESET} $*"
}

success() {
    echo -e "${GREEN}[OK]${RESET} $*"
}

warning() {
    echo -e "${YELLOW}[WARN]${RESET} $*"
}

error() {
    echo -e "${RED}[ERROR]${RESET} $*" >&2
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}


# Ejecutar script


run_script() {

    local script="$1"
    shift || true

    if [[ ! -f "$script" ]]; then
        error "El script no existe:"
        error "$script"
        pause
        return 1
    fi

    if [[ ! -r "$script" ]]; then
        error "El script no se puede leer:"
        error "$script"
        pause
        return 1
    fi

    echo
    info "Ejecutando:"
    echo "$script"

    echo

    # Ejecutamos explícitamente con Bash.
    # Esto evita problemas si el usuario ejecuta
    # accidentalmente el script mediante /bin/sh.
    bash "$script" "$@"

    local exit_code=$?

    echo

    if [[ "$exit_code" -eq 0 ]]; then
        success "Operación finalizada correctamente."
    else
        error "El script terminó con código: $exit_code"
    fi

    pause

    return "$exit_code"
}


# Comprobar estructura


check_project_structure() {

    local missing=false

    local directories=(
        "$SYSTEM_DIR"
        "$DOCKER_DIR"
        "$NETWORK_DIR"
        "$BACKUP_DIR"
        "$DEVELOPMENT_DIR"
        "$GIT_DIR"
        "$UTILITIES_DIR"
    )

    for directory in "${directories[@]}"; do

        if [[ ! -d "$directory" ]]; then
            warning "Directorio no encontrado: $directory"
            missing=true
        fi

    done

    if [[ "$missing" == true ]]; then
        warning "Algunas categorías todavía no están implementadas."
    fi
}


# Banner


show_banner() {

    clear

    echo
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${CYAN}║${RESET}                    ${WHITE}UBUNTU TOOLKIT${RESET}                    ${CYAN}║${RESET}"
    echo -e "${CYAN}║${RESET}                    Version $SCRIPT_VERSION                     ${CYAN}║${RESET}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${RESET}"
    echo

}


# Información rápida


show_quick_info() {

    echo -e "${BLUE}Sistema:${RESET} ${PRETTY_NAME:-Ubuntu}"

    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release

        echo -e "${BLUE}Distribución:${RESET} ${PRETTY_NAME:-Desconocida}"
    fi

    echo -e "${BLUE}Kernel:${RESET} $(uname -r)"
    echo -e "${BLUE}Usuario:${RESET} $(whoami)"
    echo -e "${BLUE}Directorio:${RESET} $PROJECT_ROOT"

}


# Menú System


system_menu() {

    while true; do

        show_banner

        echo -e "${WHITE}SYSTEM${RESET}"
        separator

        echo
        echo "1) Información del sistema"
        echo "2) Comprobar almacenamiento"
        echo "3) Mantenimiento seguro"
        echo "0) Volver"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                run_script "$SYSTEM_DIR/system-info.sh"
                ;;

            2)
                run_script "$SYSTEM_DIR/disk-check.sh"
                ;;

            3)
                run_maintenance
                ;;

            0)
                return
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


# Maintenance


run_maintenance() {

    local script="$SYSTEM_DIR/maintenance.sh"

    if [[ ! -f "$script" ]]; then
        error "No se encontró maintenance.sh."
        pause
        return
    fi

    echo
    warning "MANTENIMIENTO DEL SISTEMA"
    echo
    echo "Este módulo puede modificar el sistema."
    echo
    echo "Incluye:"
    echo
    echo "  - Limpieza segura de APT"
    echo "  - Actualización opcional"
    echo "  - Verificación DPKG"
    echo "  - Ajustes opcionales de memoria"
    echo "  - Configuración de TRIM"
    echo "  - Limpieza de temporales"
    echo
    echo "No incluye:"
    echo
    echo "  - apt autoremove"
    echo "  - eliminación de Docker"
    echo "  - eliminación de perfiles"
    echo "  - modificación de /etc/fstab"
    echo
    echo "Se recomienda ejecutar primero:"
    echo
    echo "  maintenance.sh --dry-run"
    echo

    if ! confirm_action "¿Continuar con mantenimiento?"; then
        info "Operación cancelada."
        pause
        return
    fi

    echo

    if [[ "$EUID" -ne 0 ]]; then

        info "El mantenimiento requiere privilegios administrativos."

        echo

        sudo bash "$script"

    else

        bash "$script"

    fi

    local exit_code=$?

    echo

    if [[ "$exit_code" -eq 0 ]]; then
        success "Mantenimiento finalizado."
    else
        error "Mantenimiento terminó con código: $exit_code"
    fi

    pause
}


# Confirmación


confirm_action() {

    local prompt="$1"
    local answer

    read -rp "$prompt [y/N]: " answer

    [[ "$answer" =~ ^[Yy]$ ]]

}


# Menú Docker


docker_menu() {

    while true; do

        show_banner

        echo -e "${WHITE}DOCKER${RESET}"
        separator

        echo
        echo "1) Información de Docker"
        echo "2) Limpieza de Docker"
        echo "0) Volver"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                run_optional_script \
                    "$DOCKER_DIR/info.sh" \
                    "docker/info.sh"
                ;;

            2)
                run_optional_script \
                    "$DOCKER_DIR/cleanup.sh" \
                    "docker/cleanup.sh"
                ;;

            0)
                return
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


# Menú Network


network_menu() {

    while true; do

        show_banner

        echo -e "${WHITE}NETWORK${RESET}"
        separator

        echo
        echo "1) Diagnóstico de red"
        echo "0) Volver"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                run_optional_script \
                    "$NETWORK_DIR/network-check.sh" \
                    "network/network-check.sh"
                ;;

            0)
                return
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


