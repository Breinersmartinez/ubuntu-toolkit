backup_menu() {

    while true; do

        show_banner

        echo -e "${WHITE}BACKUP${RESET}"
        separator

        echo
        echo "1) Backup de configuraciones"
        echo "0) Volver"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                run_optional_script \
                    "$BACKUP_DIR/backup-config.sh" \
                    "backup/backup-config.sh"
                ;;

            0)
                return
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


# Menú Development


development_menu() {

    while true; do

        show_banner

        echo -e "${WHITE}DEVELOPMENT${RESET}"
        separator

        echo
        echo "1) Preparar entorno de desarrollo"
        echo "2) Crear proyecto"
        echo "0) Volver"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                run_optional_script \
                    "$DEVELOPMENT_DIR/dev-setup.sh" \
                    "development/dev-setup.sh"
                ;;

            2)
                run_optional_script \
                    "$DEVELOPMENT_DIR/new-project.sh" \
                    "development/new-project.sh"
                ;;

            0)
                return
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


