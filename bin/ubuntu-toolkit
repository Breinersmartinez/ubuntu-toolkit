    while true; do

        show_banner

        echo -e "${WHITE}GIT${RESET}"
        separator

        echo
        echo "1) Git workflow"
        echo "0) Volver"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                run_optional_script \
                    "$GIT_DIR/git-workflow.sh" \
                    "git/git-workflow.sh"
                ;;

            0)
                return
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


# Menú Utilities


utilities_menu() {

    while true; do

        show_banner

        echo -e "${WHITE}UTILITIES${RESET}"
        separator

        echo
        echo "1) TXT → Markdown"
        echo "2) Limpiar Downloads"
        echo "0) Volver"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                run_optional_script \
                    "$UTILITIES_DIR/txt2md.sh" \
                    "utilities/txt2md.sh"
                ;;

            2)
                run_optional_script \
                    "$UTILITIES_DIR/downloads-cleanup.sh" \
                    "utilities/downloads-cleanup.sh"
                ;;

            0)
                return
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


# Scripts opcionales


run_optional_script() {

    local script="$1"
    local relative_path="$2"

    if [[ ! -f "$script" ]]; then

        echo
        warning "Esta función todavía no está implementada."

        echo
        echo "Script esperado:"
        echo "$relative_path"

        echo
        echo "Puedes añadirlo posteriormente al proyecto."

        pause
        return

    fi

    run_script "$script"

}


# Menú principal


main_menu() {

    while true; do

        show_banner

        show_quick_info

        separator

        echo
        echo "1) System"
        echo "2) Docker"
        echo "3) Network"
        echo "4) Backup"
        echo "5) Development"
        echo "6) Git"
        echo "7) Utilities"
        echo "0) Salir"

        echo

        read -rp "Selecciona una opción: " option

        case "$option" in

            1)
                system_menu
                ;;

            2)
                docker_menu
                ;;

            3)
                network_menu
                ;;

            4)
                backup_menu
                ;;

            5)
                development_menu
                ;;

            6)
                git_menu
                ;;

            7)
                utilities_menu
                ;;

            0)
                clear
                echo
                echo "Ubuntu Toolkit finalizado."
                echo
                exit 0
                ;;

            *)
                warning "Opción no válida."
                sleep 1
                ;;

        esac

    done
}


# CLI directo


run_direct_command() {

    local command="$1"
    shift || true

    case "$command" in

        system-info)
            run_script "$SYSTEM_DIR/system-info.sh" "$@"
            ;;

        disk-check)
            run_script "$SYSTEM_DIR/disk-check.sh" "$@"
            ;;

        maintenance)

            if [[ "$EUID" -ne 0 ]]; then
                sudo bash "$SYSTEM_DIR/maintenance.sh" "$@"
            else
                bash "$SYSTEM_DIR/maintenance.sh" "$@"
            fi

            ;;

        docker-cleanup)
            run_optional_script \
                "$DOCKER_DIR/cleanup.sh" \
                "docker/cleanup.sh"
            ;;

        network-check)
            run_optional_script \
                "$NETWORK_DIR/network-check.sh" \
                "network/network-check.sh"
            ;;

        --version|-v)

            echo "Ubuntu Toolkit $SCRIPT_VERSION"
            ;;

        --help|-h)

            cat <<EOF

Ubuntu Toolkit $SCRIPT_VERSION

Uso:

    ./ubuntu-toolkit
    ./ubuntu-toolkit system-info
    ./ubuntu-toolkit disk-check
    ./ubuntu-toolkit maintenance
    ./ubuntu-toolkit maintenance --dry-run
    ./ubuntu-toolkit --version
    ./ubuntu-toolkit --help

Comandos:

    system-info       Información del sistema
    disk-check        Diagnóstico de almacenamiento
    maintenance       Mantenimiento seguro
    docker-cleanup    Limpieza de Docker
    network-check     Diagnóstico de red

Sin argumentos:

    Abre el menú interactivo.

EOF
            ;;

        *)

            error "Comando desconocido: $command"

            echo
            echo "Ejecuta:"
            echo
            echo "    ./ubuntu-toolkit --help"

            return 1
            ;;

    esac
}


# Main


check_project_structure

if [[ $# -gt 0 ]]; then

    run_direct_command "$@"

else

    main_menu

fi

